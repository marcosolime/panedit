# Render di uNmINeD (≈730 MB, 47k file): si distribuisce a parte come zip,
# da estrarre nella radice del progetto senza rinominare la cartella.
render_*/
*.zip

# Sul repo vanno solo le mappe nominate secondo la convenzione
# panera_AAAA-MM-GG_hhmm_<autore>_<stato>.geojson; le altre (prove, copie) restano locali.
data/*.geojson
!data/panera_????-??-??_????_*_*.geojson

# Python
__pycache__/
*.pyc

